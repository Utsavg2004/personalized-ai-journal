# Copy to backend/.env
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth
JWT_SECRET=development-secret-change-in-production-min-32-chars

# LLM Provider ("openrouter" | "ollama")
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL_NAME=llama3.2

# =========================
# LLM - OpenRouter
# =========================
# To run the LLM through OpenRouter's cloud API instead of a local Ollama
# instance, comment out the four LLM_* lines above and uncomment these.
# Get a free key at https://openrouter.ai/keys

# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-openrouter-key-here
# LLM_MODEL_NAME=openrouter/free

# Embedding Provider ("openai" | "ollama" | "openrouter")
# NOTE: journal_chunks.embedding is a fixed-width pgvector column (currently
# vector(768), sized for Ollama's nomic-embed-text). Switching to a provider
# with a different output dimension (e.g. OpenAI's text-embedding-3-small is
# 1536) requires altering that column to match, or inserts will fail.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
