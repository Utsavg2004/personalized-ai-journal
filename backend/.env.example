# Copy to backend/.env
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth
JWT_SECRET=development-secret-change-in-production-min-32-chars

# LLM Provider ("openrouter" | "ollama")
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-key-here
LLM_MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free

# Embedding Provider ("openai" | "ollama" | "openrouter")
# NOTE: journal_chunks.embedding is a fixed-width pgvector column (currently
# vector(768), sized for Ollama's nomic-embed-text). Switching to a provider
# with a different output dimension (e.g. OpenAI's text-embedding-3-small is
# 1536) requires altering that column to match, or inserts will fail.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
