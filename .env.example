# ==============================================================================
# Personalized AI Journal (RAG MVP) - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env in both the project root and backend directory.
# NEVER commit actual secrets or your .env file to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Authentication
# If validating custom JWTs or offline tokens
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported values: "openrouter" | "ollama"
# ------------------------------------------------------------------------------
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Used when LLM_PROVIDER=openrouter)
# Sign up at https://openrouter.ai to generate an API key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-openrouter-api-key
LLM_MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free

# Ollama Configuration (Used when LLM_PROVIDER=ollama)
# Ensure Ollama is running locally: ollama run llama3.2
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/api
# LLM_API_KEY=not-required
# LLM_MODEL_NAME=llama3.2

# ------------------------------------------------------------------------------
# Embedding Provider Configuration
# Supported values: "openai" | "ollama" | "openrouter"
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-openai-or-openrouter-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Ollama Embedding Alternative:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434/api
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
